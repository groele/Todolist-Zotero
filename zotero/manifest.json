{
  "manifest_version": 2,
  "name": "Todolist - 学术日程与研读待办",
  "version": "3.0.1",
  "description": "Todolist for Zotero: 专为学术科研、文献研读与论文写作打造的高颜值全功能任务看板与日程管理插件 (完美支持 Zotero 10 & 7+)",
  "homepage_url": "https://github.com/groele/Todolist-Zotero",
  "author": "groele",
  "icons": {
    "48": "chrome/content/icons/icon48.png",
    "96": "chrome/content/icons/icon128.png"
  },
  "applications": {
    "zotero": {
      "id": "todolist@groele.org",
      "strict_min_version": "6.999",
      "strict_max_version": "15.*",
      "update_url": "https://raw.githubusercontent.com/groele/Todolist-Zotero/main/zotero/update.json"
    }
  },
  "browser_specific_settings": {
    "zotero": {
      "id": "todolist@groele.org",
      "strict_min_version": "6.999",
      "strict_max_version": "15.*",
      "update_url": "https://raw.githubusercontent.com/groele/Todolist-Zotero/main/zotero/update.json"
    }
  }
}
